---
// Mermaid component for rendering diagrams
---

<script is:inline>
  // Simple flag to prevent multiple loads
  if (window.mermaidLoaded) {
    console.log('Mermaid already loaded, skipping...');
  } else {
    window.mermaidLoaded = true;
    
    function renderMermaid() {
      if (typeof mermaid === 'undefined') {
        console.log('Mermaid not available');
        return;
      }
      
      const elements = document.querySelectorAll('.mermaid');
      if (elements.length === 0) {
        return;
      }
      
      console.log(`Found ${elements.length} mermaid elements`);
      
      // Initialize with theme
      const htmlElement = document.querySelector("html");
      const currentTheme = htmlElement?.getAttribute("data-theme");
      
      if (typeof mermaid.initialize === 'function') {
        if (currentTheme === "light") {
          mermaid.initialize({ startOnLoad: true, securityLevel: 'loose', theme: 'forest' });
        } else {
          mermaid.initialize({ startOnLoad: true, securityLevel: 'loose', theme: 'dark' });
        }
      }
      
      if (typeof mermaid.run === 'function') {
        mermaid.run();
      } else if (typeof mermaid.init === 'function') {
        mermaid.init();
      }
    }
    
    function loadMermaid() {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/mermaid@10.6.1/dist/mermaid.min.js';
      script.onload = () => {
        console.log('Mermaid loaded');
        setTimeout(renderMermaid, 100);
      };
      document.head.appendChild(script);
    }
    
    // Load on page load
    loadMermaid();
    
    // Re-render on navigation
    document.addEventListener('astro:page-load', () => {
      setTimeout(renderMermaid, 100);
    });
    
    document.addEventListener('astro:after-swap', () => {
      setTimeout(renderMermaid, 100);
    });
  }
</script> 