---
export interface Props {
  apiEndpoints: { name: string; url: string }[];
}

const { apiEndpoints } = Astro.props;
---
<div id="api-statuses" class="shadow rounded-xl p-6 sm:p-8">
  <!-- Statuses will be loaded here -->
</div>

<script define:vars={{ apiEndpoints }}>
  const container = document.getElementById('api-statuses');

  async function checkApiStatus(api) {
    const apiDiv = document.createElement('div');
    apiDiv.className = 'mb-6 pb-6 border-b border-gray-200 dark:border-gray-700 last:border-b-0 last:mb-0 last:pb-0';

    const nameHeader = document.createElement('h2');
    nameHeader.className = 'text-lg font-semibold mb-1';
    const link = document.createElement('a');
    link.href = api.url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.className = 'text-accent underline hover:opacity-80';
    link.textContent = api.name;
    nameHeader.appendChild(link);

    const statusP = document.createElement('p');
    statusP.className = 'text-base';
    statusP.textContent = 'Status: ';
    const statusSpan = document.createElement('span');
    statusSpan.textContent = 'Loading...';
    statusP.appendChild(statusSpan);

    apiDiv.appendChild(nameHeader);
    apiDiv.appendChild(statusP);
    container.appendChild(apiDiv);

    try {
      const response = await fetch(api.url);
      const status = response.ok ? 'Healthy' : `Error: ${response.status}`;
      statusSpan.textContent = status;
      statusSpan.className = response.ok ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400';

      if (response.status) {
        const statusCodeP = document.createElement('p');
        statusCodeP.className = 'text-sm text-gray-500 dark:text-gray-400';
        statusCodeP.textContent = `Status Code: ${response.status} ${response.statusText ? `(${response.statusText})` : ''}`;
        apiDiv.appendChild(statusCodeP);
      }
    } catch (error) {
      statusSpan.textContent = `Failed to fetch: ${error.message}`;
      statusSpan.className = 'text-red-600 dark:text-red-400';
    }
  }

  apiEndpoints.forEach(checkApiStatus);
</script>