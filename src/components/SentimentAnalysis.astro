---
// SentimentAnalysis.astro - AFINN Sentiment Analysis Component
---

<div id="sentiment-analysis">
  <div id="loading">Loading real Reddit data from r/HongKong...</div>
  <div id="results"></div>
</div>

<script>
  interface SentimentData {
    id: string;
    url: string;
    title: string;
    positive: number;
    negative: number;
    neutral: number;
  }

  let loading = true;
  let error: string | null = null;
  let results: SentimentData[] = [];

  // Utility function to load scripts
  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) {
        resolve();
        return;
      }

      const script = document.createElement('script');
      script.src = src;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(script);
    });
  }

  // Stop words for filtering
  const stopWords = [
    'about', 'after', 'all', 'also', 'am', 'an', 'and', 'another', 'any', 'are', 'as', 'at', 'be',
    'because', 'been', 'before', 'being', 'between', 'both', 'but', 'by', 'came', 'can',
    'come', 'could', 'did', 'do', 'each', 'for', 'from', 'get', 'got', 'has', 'had',
    'he', 'have', 'her', 'here', 'him', 'himself', 'his', 'how', 'if', 'in', 'into',
    'is', 'it', 'like', 'make', 'many', 'me', 'might', 'more', 'most', 'much', 'must',
    'my', 'never', 'now', 'of', 'on', 'only', 'or', 'other', 'our', 'out', 'over',
    'said', 'same', 'see', 'should', 'since', 'some', 'still', 'such', 'take', 'than',
    'that', 'the', 'their', 'them', 'then', 'there', 'these', 'they', 'this', 'those',
    'through', 'to', 'too', 'under', 'up', 'very', 'was', 'way', 'we', 'well', 'were',
    'what', 'where', 'which', 'while', 'who', 'with', 'would', 'you', 'your', 'a', 'i', 'its', 'why'
  ];

  function buildFreq(repliesText: string): number {
    if (!repliesText) return 0;
    const convert = repliesText.replace(/[^\w\s]/gi, '').toLowerCase().split(" ");
    let totalScore = 0;
    for (let i = 0; i < convert.length; i++) {
      const currentWord = convert[i];
      totalScore += (window as any).afinn?.[currentWord] || 0;
    }
    return totalScore;
  }

  function showResult(jsonResult: SentimentData) {
    results.push(jsonResult);
    renderResults();
  }

  function renderResults() {
    const resultsDiv = document.getElementById('results');
    if (!resultsDiv) return;

    resultsDiv.innerHTML = '';
    
    if (results.length > 0) {
      const loadingDiv = document.getElementById('loading');
      if (loadingDiv) {
        loadingDiv.innerHTML = '<p><em>Sentiment analysis complete! Results show real data from r/HongKong.</em></p>';
      }
    }

    results.forEach((result) => {
      const total = result.positive + result.negative + result.neutral;
      const positivePct = total > 0 ? Math.round((result.positive / total) * 100) : 0;
      const negativePct = total > 0 ? Math.round((result.negative / total) * 100) : 0;
      const neutralPct = total > 0 ? Math.round((result.neutral / total) * 100) : 0;
      
      const resultDiv = document.createElement('div');
      resultDiv.innerHTML = `
        <strong>${result.title}</strong>
        <p>
          <a href="${result.url}" target="_blank" rel="noopener noreferrer">
            View post on Reddit
          </a>
        </p>
        
        <div>
          <table>
            <thead>
              <tr>
                <th>Sentiment</th>
                <th>Count</th>
                <th>Percentage</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Positive</td>
                <td>${result.positive}</td>
                <td>${positivePct}%</td>
              </tr>
              <tr>
                <td>Negative</td>
                <td>${result.negative}</td>
                <td>${negativePct}%</td>
              </tr>
              <tr>
                <td>Neutral</td>
                <td>${result.neutral}</td>
                <td>${neutralPct}%</td>
              </tr>
              <tr>
                <td><strong>Total</strong></td>
                <td><strong>${total}</strong></td>
                <td><strong>100%</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
      `;
      resultsDiv.appendChild(resultDiv);
    });
  }

  async function parseResult(link: string) {
    const endPoint = "https://reddit.com" + link + ".json?limit=100";
    
    try {
      const response = await fetch(endPoint);
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const data = await response.json();
      const title = data[0].data.children[0].data["title"];
      const replies = data[1]["data"].children;
      const url = "https://reddit.com" + link;
      const noOfReplies = replies.length;

      const result: SentimentData = {
        id: data[0].data.children[0].data["id"],
        url: url,
        title: title,
        negative: 0,
        neutral: 0,
        positive: 0
      };

      for (let i = 0; i < noOfReplies; i++) {
        const reply = replies[i]["data"].body;
        const score = buildFreq(reply);
        
        switch (true) {
          case score === 0:
            result.neutral += 1;
            break;
          case score > 0:
            result.positive += 1;
            break;
          case score < 0:
            result.negative += 1;
            break;
        }
      }

      if (result.negative === 0 && result.positive === 0 && result.neutral === 0) {
        return;
      }
      showResult(result);
    } catch (error) {
      console.error('Error fetching post data:', error);
    }
  }

  async function getPost() {
    const endPoint = "https://reddit.com/r/hongkong.json?limit=3";
    
    try {
      console.log('Fetching from:', endPoint);
      const response = await fetch(endPoint);
      console.log('Response status:', response.status);
      console.log('Response headers:', response.headers);
      
      if (!response.ok) {
        console.log('Response not ok, status:', response.status);
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const data = await response.json();
      console.log('Response data:', data);
      const entries = data["data"].children;
      
      if (!entries || entries.length === 0) {
        error = "No posts found from r/HongKong at this time. The subreddit may be private or temporarily unavailable.";
        loading = false;
        renderError();
        return;
      }
      
      // Process posts sequentially to avoid overwhelming the API
      for (let i = 0; i < entries.length; i++) {
        const link = entries[i]["data"]["permalink"];
        await parseResult(link);
      }
      
      setTimeout(() => {
        loading = false;
      }, 1000);
    } catch (error) {
      console.error('Error fetching posts:', error);
      // Show error message when API fails
      const loadingDiv = document.getElementById('loading');
      if (loadingDiv) {
        loadingDiv.innerHTML = '<p><strong>Unable to fetch Reddit data</strong><br />The Reddit API may be temporarily unavailable or the subreddit may be private. Please try again later.</p>';
      }
    }
  }

  function renderError() {
    const loadingDiv = document.getElementById('loading');
    if (loadingDiv && error) {
      loadingDiv.innerHTML = `<p><strong>No data available</strong><br />${error}</p>`;
    }
  }

  async function initialize() {
    try {
      // Load AFINN lexicon only
      await loadScript('/assets/scripts/afinn-111.js');

      // Wait a bit for everything to settle
      setTimeout(() => {
        getPost();
      }, 500);
      
    } catch (error) {
      console.error('Failed to initialize:', error);
      const loadingDiv = document.getElementById('loading');
      if (loadingDiv) {
        loadingDiv.innerHTML = 'Failed to load required libraries. Please refresh the page.';
      }
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }
</script>
