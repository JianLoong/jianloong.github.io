---
import Main from '../layouts/Main.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ApiHealthCheck from '../components/ApiHealthCheck.astro';

const apiEndpoints = [
  { name: 'Malaysia API', url: 'https://pangrammer.dev/malaysia-api/' },
  { name: 'AITA Site', url: 'https://pangrammer.dev/aita/' },
  { name: 'AITA API', url: 'https://api.pangrammer.dev/aita/api/v2/ping' },
  { name: 'Sentiment Analysis Site', url: 'https://pangrammer.dev/sentimentanalysis/' },
  { name: 'Word Cloud Generator Site', url: 'https://pangrammer.dev/word-cloud-generator/'},
];
---

<Layout title="API Health Check">
  <Header />
  <Main pageTitle="API Health Check" pageDesc="Check the health status of various APIs.">
    <section class="w-full max-w-app mx-auto px-4 py-8">
      <ApiHealthCheck apiEndpoints={apiEndpoints} />
    </section>
  </Main>
  <Footer />
</Layout>