---
layout: layouts/base.njk
showProgress: true
---
<article class="article">
  <p class="article-meta">{{ category }} · {{ date | dateFormat }}{% if readingTime %} · {{ readingTime }} min{% endif %}</p>
  <h1>{{ title }}</h1>
  {% if description %}
  <p class="deck">{{ description }}</p>
  {% endif %}
  {{ content | safe }}
  {% if related.length %}
  <div class="related">
    <h2>Continue reading</h2>
    <ul>
      {% for item in related %}
      <li><a href="{{ item.url }}">{{ item.title }}</a></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</article>
