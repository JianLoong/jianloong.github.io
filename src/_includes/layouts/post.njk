---
layout: layouts/base.njk
showProgress: true
ogType: article
---
<article class="article">
  <p class="article-meta">{{ category }} · {{ date | dateFormat }}{% if readingTime %} · {{ readingTime }} min{% endif %}</p>
  <h1>{{ title }}</h1>
  {% if description %}
  <p class="deck">{{ description }}</p>
  {% endif %}
  {{ content | safe }}
  {% include "partials/comments.njk" %}
</article>
