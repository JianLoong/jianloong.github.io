<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title and title != site.title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">

  <meta name="theme-color" content="#e2e5e8">
  <script>
    (function () {
      try {
        var theme = localStorage.getItem("theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#0a0d18" : "#e2e5e8");
      } catch (e) {}
    })();
  </script>

  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ page.fileSlug | ogCard }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ogAlt or title or site.title }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ page.fileSlug | ogCard }}">

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ site.title | json | safe }},
      "url": {{ site.url | json | safe }},
      "description": {{ (description or site.description) | json | safe }},
      "author": {
        "@type": "Person",
        "name": {{ site.author | json | safe }},
        "url": {{ site.url | json | safe }},
        "sameAs": [{{ site.github | json | safe }}, {{ site.linkedin | json | safe }}, {{ site.kaggle | json | safe }}]
      }
    }
  </script>
  {% if ogType == "article" %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | json | safe }},
      "description": {{ description | json | safe }},
      "datePublished": {{ date | isoDate | json | safe }},
      "url": {{ (site.url + page.url) | json | safe }},
      "mainEntityOfPage": {{ (site.url + page.url) | json | safe }},
      "author": {
        "@type": "Person",
        "name": {{ site.author | json | safe }},
        "url": {{ site.url | json | safe }}
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ (site.url + "/") | json | safe }}},
        {"@type": "ListItem", "position": 2, "name": "Writing", "item": {{ (site.url + "/writing/") | json | safe }}},
        {"@type": "ListItem", "position": 3, "name": {{ title | json | safe }}, "item": {{ (site.url + page.url) | json | safe }}}
      ]
    }
  </script>
  {% endif %}

  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% if showProgress %}
  <div class="progress" data-progress></div>
  {% endif %}
  <div class="wrap">
    {% include "partials/header.njk" %}
    <main id="main">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
