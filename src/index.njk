---
layout: layouts/page.njk
title: Jian
permalink: /
---
{% set rtHot = 8 %}{% set rtCool = 6 %}{% set stHot = 30 %}{% set stCool = 10 %}
<section class="hero">
  <div class="hero-copy">
    <h1>Notes on reliability, data, and making things that last.</h1>
    <p class="lede">Site Reliability Engineer at ANZ in Melbourne. My work centres on automation and Google Cloud; I write here about reliability, engineering practice, and the open-source tools I maintain.</p>
    <div class="hero-links">
      <a href="{{ site.github }}">GitHub</a>
      <a href="{{ site.linkedin }}">LinkedIn</a>
      <a href="mailto:{{ site.email }}">Email</a>
    </div>
  </div>
  <picture class="hero-plate">
    <source media="(max-width: 46rem)" srcset="/assets/hero/home-mobile.jpg">
    <img src="/assets/hero/home.jpg" alt="A small figure in a hooded top drawn in loose bone-white ink on a near-black ground: the hood is up and the face is an empty shadow with no features, and no hands are visible. It looks toward a wide field of faint dots joined into a loose network by thin lines, two of them filled — one warm amber, one pale blue." width="1376" height="768" fetchpriority="high" decoding="async">
  </picture>
</section>

<div class="section-head">
  <h2>Latest writing</h2>
  <a href="/writing/">All posts</a>
</div>
<p class="atlas-legend">
  <span><b>{{ collections.posts | length }}</b> entries</span>
  <span>magnitude = reading time</span>
  <span class="legend-key">
    <span><i style="background: var(--accent)"></i>{{ rtHot }}+ min</span>
    <span><i style="background: var(--star-cool)"></i>{{ rtCool }}–{{ rtHot - 1 }} min</span>
    <span><i style="background: var(--star-faint)"></i>under {{ rtCool }} min</span>
  </span>
</p>

<section class="post-list">
  {% for post in collections.posts | limit(3) %}
  <a class="post-card" href="{{ post.url }}" style="--mag-tint: {% if post.data.readingTime >= rtHot %}var(--accent){% elif post.data.readingTime >= rtCool %}var(--star-cool){% else %}var(--star-faint){% endif %}">
    <span class="post-meta">{{ post.date | dateFormat }}{% if post.data.readingTime %}<br>{{ post.data.readingTime }} min{% endif %}</span>
    <div>
      <h3>{{ post.data.title }}</h3>
      <p>{{ post.data.description }}</p>
    </div>
  </a>
  {% endfor %}
</section>

<div class="section-head">
  <h2>Selected work</h2>
  <a href="/projects/">All projects</a>
</div>
<p class="atlas-legend">
  <span><b>{{ projects | length }}</b> objects</span>
  <span>magnitude = stars</span>
  <span class="legend-key">
    <span><i style="background: var(--accent)"></i>{{ stHot }}+</span>
    <span><i style="background: var(--star-cool)"></i>{{ stCool }}–{{ stHot - 1 }}</span>
    <span><i style="background: var(--star-faint)"></i>under {{ stCool }}</span>
  </span>
</p>

<section class="project-grid">
  {% for project in projects | limit(2) %}
  {% set stars = project.meta.split('★')[0] | int %}
  <a class="project" href="{{ project.url }}" style="--mag-tint: {% if stars >= stHot %}var(--accent){% elif stars >= stCool %}var(--star-cool){% else %}var(--star-faint){% endif %}">
    <h3>{{ project.title }}</h3>
    <p>{{ project.blurb }}</p>
    <span class="post-meta">{{ project.meta }}</span>
  </a>
  {% endfor %}
</section>
