---
layout: layouts/page.njk
title: Jian Liew
permalink: /
---
<section class="hero">
  <p class="kicker">Software engineer</p>
  <h1>Notes on reliability, data, and making things that last.</h1>
  <p class="lede">I am Jian Loong Liew, a Site Reliability Engineer based in Melbourne. My work at ANZ centres on automation and Google Cloud. This site is where I write about reliability, engineering practice, and the open-source software I maintain.</p>
  <div class="hero-links">
    <a href="{{ site.github }}">GitHub</a>
    <a href="{{ site.linkedin }}">LinkedIn</a>
    <a href="mailto:{{ site.email }}">Email</a>
  </div>
</section>

<div class="section-head">
  <h2>Latest writing</h2>
  <a href="/writing/">All posts</a>
</div>

<section class="post-list">
  {% for post in collections.posts | limit(3) %}
  <a class="post-card" href="{{ post.url }}">
    <span class="post-meta">{{ post.date | dateFormat }}{% if post.data.readingTime %}<br>{{ post.data.readingTime }} min{% endif %}</span>
    <div>
      <h3>{{ post.data.title }}</h3>
      <p>{{ post.data.description }}</p>
    </div>
  </a>
  {% endfor %}
</section>

<div class="section-head">
  <h2>Selected work</h2>
</div>

<section class="project-grid">
  {% for project in projects | limit(2) %}
  <a class="project" href="{{ project.url }}">
    <h3>{{ project.title }}</h3>
    <p>{{ project.blurb }}</p>
    <span class="post-meta">{{ project.meta }}</span>
  </a>
  {% endfor %}
</section>
